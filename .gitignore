# Node dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment and secrets (CRITICAL: Never commit database credentials or keys)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Production builds
/dist/
dist-ssr/
!frontend/dist/
!frontend/dist/**
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database Backups (Runtime generated backups)
backend/data/backups/*.json
!backend/data/backups/.gitkeep

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
git.cmd
push.bat
start.bat
