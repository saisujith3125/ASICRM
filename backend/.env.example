NODE_ENV=development
PORT=5000

# MongoDB Atlas URI (Replace with your own cluster connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/asicrm?retryWrites=true&w=majority

# OTP Configuration
OTP_EXPIRY_MS=600000
RESEND_COOLDOWN_MS=90000

# SMS Provider Configuration
SMS_PROVIDER_ENABLED=false
PAY4SMS_BASE_URL=http://pay4sms.in/sendsms/
PAY4SMS_TOKEN=your_sms_token_here
PAY4SMS_CREDIT=2
PAY4SMS_SENDER=ASISYS
PAY4SMS_TEMPLATE_ID=your_template_id_here
SMS_MESSAGE_TEMPLATE=Dear User, your login OTP for Active System Integration is ${otp}. This OTP is valid for 10 minutes.
